{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "날짜별 뉴스 v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "date", "articles"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "enum": ["news", "test"] },
    "date": { "type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "articles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/article" }
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\dZ$"
    },
    "article": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "source", "titleOriginal", "titleKo", "summaryKo", "url",
        "publishedAt", "access", "verification", "collectedAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 1020,
          "pattern": "^(wsj|nyt|washpost|latimes|bloomberg|reuters|cnbc|marketwatch|ft|ap):https://[^/?#\\s]+/[^?#\\s]+$"
        },
        "source": {
          "enum": ["wsj", "nyt", "washpost", "latimes", "bloomberg", "reuters", "cnbc", "marketwatch", "ft", "ap"]
        },
        "titleOriginal": { "type": "string", "minLength": 1, "maxLength": 240, "pattern": "\\S" },
        "titleKo": { "type": "string", "minLength": 1, "maxLength": 180, "pattern": "\\S" },
        "summaryKo": {
          "type": "array",
          "maxItems": 3,
          "items": { "type": "string", "minLength": 1, "maxLength": 220, "pattern": "\\S" }
        },
        "url": {
          "type": "string",
          "format": "uri",
          "maxLength": 1000,
          "pattern": "^https://[^/?#\\s]+/[^?#\\s]+$"
        },
        "publishedAt": { "$ref": "#/$defs/timestamp" },
        "access": { "enum": ["free", "paywall", "unknown"] },
        "verification": { "enum": ["full", "partial", "headline"] },
        "collectedAt": { "$ref": "#/$defs/timestamp" }
      },
      "if": { "properties": { "verification": { "const": "headline" } } },
      "then": { "properties": { "summaryKo": { "maxItems": 0 } } },
      "else": { "properties": { "summaryKo": { "minItems": 1 } } }
    }
  }
}
